<Window x:Class="SniPro.App.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource CaptureOverlayTitle}"
        x:Name="OverlayWindowRoot"
        AutomationProperties.AutomationId="CaptureOverlayWindow"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        Focusable="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        KeyDown="CaptureOverlayWindow_KeyDown">
    <Grid x:Name="OverlayRoot"
          Background="Transparent"
          MouseLeftButtonDown="OverlayRoot_MouseLeftButtonDown"
          MouseMove="OverlayRoot_MouseMove"
          MouseLeftButtonUp="OverlayRoot_MouseLeftButtonUp"
          LostMouseCapture="OverlayRoot_LostMouseCapture">
        <Path x:Name="DimOverlayPath"
              Fill="#880F0B19"
              IsHitTestVisible="False" />

        <Canvas x:Name="OverlayCanvas"
                IsHitTestVisible="False">
            <Rectangle x:Name="SelectionRectangle"
                       Visibility="Collapsed"
                       Fill="Transparent"
                       Stroke="#D9C2FF"
                       StrokeThickness="2" />

            <Rectangle x:Name="RecordingOutline"
                       Visibility="Collapsed"
                       Fill="Transparent"
                       Stroke="#FF8267"
                       StrokeThickness="2"
                       Opacity="0.9" />

            <Border x:Name="SelectionInfoBorder"
                    Visibility="Collapsed"
                    Background="#E9231B30"
                    BorderBrush="#886E528B"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,6">
                <TextBlock x:Name="SelectionInfoText"
                           Foreground="White"
                           FontSize="12"
                           FontWeight="SemiBold" />
            </Border>
        </Canvas>

        <Canvas x:Name="ControlCanvas"
                Panel.ZIndex="20">
            <Border x:Name="HintBorder"
                    Padding="17,10"
                    MaxWidth="1200"
                    Background="#E9231B30"
                    BorderBrush="#665C456F"
                    BorderThickness="1"
                    CornerRadius="11"
                    IsHitTestVisible="False">
                <TextBlock x:Name="HintText"
                           Foreground="White"
                           FontSize="12"
                           FontWeight="Medium"
                           Text="{DynamicResource CaptureOverlayHint}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Border>

            <Ellipse x:Name="RecordingDot"
                     Width="8" Height="8"
                     Fill="#FF737B"
                     Visibility="Collapsed"
                     IsHitTestVisible="False" />

            <Button x:Name="StartRecordingButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="18,9"
                    Visibility="Collapsed"
                    Content="{DynamicResource StartRecordingButton}"
                    Click="StartRecordingButton_Click" />
        </Canvas>

        <Canvas x:Name="HandleCanvas"
                Panel.ZIndex="15"
                Background="Transparent">
            <Ellipse x:Name="TopLeftHandle"
                       Width="12"
                       Height="12"
                       Visibility="Collapsed"
                       Fill="White"
                       Stroke="#7350AE"
                       StrokeThickness="2" />
            <Ellipse x:Name="TopRightHandle"
                       Width="12"
                       Height="12"
                       Visibility="Collapsed"
                       Fill="White"
                       Stroke="#7350AE"
                       StrokeThickness="2" />
            <Ellipse x:Name="BottomLeftHandle"
                       Width="12"
                       Height="12"
                       Visibility="Collapsed"
                       Fill="White"
                       Stroke="#7350AE"
                       StrokeThickness="2" />
            <Ellipse x:Name="BottomRightHandle"
                       Width="12"
                       Height="12"
                       Visibility="Collapsed"
                       Fill="White"
                       Stroke="#7350AE"
                       StrokeThickness="2" />
            <Ellipse x:Name="TopHandle" Width="9" Height="9" Visibility="Collapsed" Fill="White" Stroke="#7350AE" StrokeThickness="2" />
            <Ellipse x:Name="RightHandle" Width="9" Height="9" Visibility="Collapsed" Fill="White" Stroke="#7350AE" StrokeThickness="2" />
            <Ellipse x:Name="BottomHandle" Width="9" Height="9" Visibility="Collapsed" Fill="White" Stroke="#7350AE" StrokeThickness="2" />
            <Ellipse x:Name="LeftHandle" Width="9" Height="9" Visibility="Collapsed" Fill="White" Stroke="#7350AE" StrokeThickness="2" />
        </Canvas>
    </Grid>
</Window>
