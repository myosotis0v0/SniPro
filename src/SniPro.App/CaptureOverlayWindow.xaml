<Window x:Class="SniPro.App.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource CaptureOverlayTitle}"
        x:Name="OverlayWindowRoot"
        AutomationProperties.AutomationId="CaptureOverlayWindow"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        Focusable="True"
        KeyDown="CaptureOverlayWindow_KeyDown">
    <Grid x:Name="OverlayRoot"
          Background="Transparent"
          MouseLeftButtonDown="OverlayRoot_MouseLeftButtonDown"
          MouseMove="OverlayRoot_MouseMove"
          MouseLeftButtonUp="OverlayRoot_MouseLeftButtonUp">
        <Path x:Name="DimOverlayPath"
              Fill="#66000000"
              IsHitTestVisible="False" />

        <Canvas x:Name="OverlayCanvas"
                IsHitTestVisible="False">
            <Rectangle x:Name="SelectionRectangle"
                       Visibility="Collapsed"
                       Fill="Transparent"
                       Stroke="White"
                       StrokeThickness="2" />

            <Border x:Name="SelectionInfoBorder"
                    Visibility="Collapsed"
                    Background="#CC000000"
                    CornerRadius="3"
                    Padding="8,4">
                <TextBlock x:Name="SelectionInfoText"
                           Foreground="White" />
            </Border>
        </Canvas>

        <TextBlock x:Name="HintText"
                   Panel.ZIndex="10"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="32,32,0,0"
                   Padding="16,8"
                   MaxWidth="1200"
                   Foreground="White"
                   Background="#99000000"
                   Text="{DynamicResource CaptureOverlayHint}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   IsHitTestVisible="False" />

        <Button x:Name="StartRecordingButton"
                Panel.ZIndex="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0"
                Padding="18,8"
                Visibility="Collapsed"
                Content="{DynamicResource StartRecordingButton}"
                Click="StartRecordingButton_Click" />

        <Canvas x:Name="HandleCanvas"
                Panel.ZIndex="15"
                Background="Transparent">
            <Rectangle x:Name="TopLeftHandle"
                       Tag="TopLeft"
                       Width="10"
                       Height="10"
                       Visibility="Collapsed"
                       Fill="White"
                       Stroke="Black"
                       StrokeThickness="1"
                       MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" />
            <Rectangle x:Name="TopRightHandle"
                       Tag="TopRight"
                       Width="10"
                       Height="10"
                       Visibility="Collapsed"
                       Fill="White"
                       Stroke="Black"
                       StrokeThickness="1"
                       MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" />
            <Rectangle x:Name="BottomLeftHandle"
                       Tag="BottomLeft"
                       Width="10"
                       Height="10"
                       Visibility="Collapsed"
                       Fill="White"
                       Stroke="Black"
                       StrokeThickness="1"
                       MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" />
            <Rectangle x:Name="BottomRightHandle"
                       Tag="BottomRight"
                       Width="10"
                       Height="10"
                       Visibility="Collapsed"
                       Fill="White"
                       Stroke="Black"
                       StrokeThickness="1"
                       MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" />
        </Canvas>
    </Grid>
</Window>
