<Window x:Class="SniPro.App.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource CaptureOverlayTitle}"
        x:Name="OverlayWindowRoot"
        AutomationProperties.AutomationId="CaptureOverlayWindow"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        Focusable="True"
        KeyDown="CaptureOverlayWindow_KeyDown">
    <Grid x:Name="OverlayRoot"
          Background="#66000000"
          MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown"
          MouseMove="OverlayCanvas_MouseMove"
          MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp">
        <Canvas x:Name="OverlayCanvas"
                IsHitTestVisible="False">
            <Rectangle x:Name="SelectionRectangle"
                       Visibility="Collapsed"
                       Fill="#33FFFFFF"
                       Stroke="White"
                       StrokeThickness="2" />

            <Border x:Name="SelectionInfoBorder"
                    Visibility="Collapsed"
                    Background="#CC000000"
                    CornerRadius="3"
                    Padding="8,4">
                <TextBlock x:Name="SelectionInfoText"
                           Foreground="White" />
            </Border>
        </Canvas>

        <TextBlock x:Name="HintText"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,32,0,0"
                   Padding="16,8"
                   Foreground="White"
                   Background="#99000000"
                   Text="{DynamicResource CaptureOverlayHint}"
                   IsHitTestVisible="False" />
    </Grid>
</Window>
