<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="SettingsWindowTitle">SniPro Settings</sys:String>
    <sys:String x:Key="AppSettingsTitle">SniPro Settings</sys:String>
    <sys:String x:Key="OutputDirectoryLabel">Output directory</sys:String>
    <sys:String x:Key="BrowseButton">Browse...</sys:String>
    <sys:String x:Key="FrameRateLabel">Frame rate (FPS)</sys:String>
    <sys:String x:Key="DurationLabel">Duration (seconds)</sys:String>
    <sys:String x:Key="ScaleLabel">Output scale (%)</sys:String>
    <sys:String x:Key="MaxColorsLabel">Maximum colors</sys:String>
    <sys:String x:Key="EnableDithering">Enable dithering</sys:String>
    <sys:String x:Key="StartupLabel">Startup</sys:String>
    <sys:String x:Key="StartWithWindows">Start with Windows</sys:String>
    <sys:String x:Key="CaptureHotkeyLabel">Capture hotkey</sys:String>
    <sys:String x:Key="LanguageLabel">Language</sys:String>
    <sys:String x:Key="LanguageSystem">System default</sys:String>
    <sys:String x:Key="LanguageEnglish">English</sys:String>
    <sys:String x:Key="LanguageSimplifiedChinese">简体中文</sys:String>
    <sys:String x:Key="ResetButton">Reset</sys:String>
    <sys:String x:Key="SaveButton">Save</sys:String>
    <sys:String x:Key="CloseButton">Close</sys:String>
    <sys:String x:Key="StatusSettingsLoaded">Settings loaded.</sys:String>
    <sys:String x:Key="StatusSettingsSaved">Settings saved.</sys:String>
    <sys:String x:Key="StatusDefaultsLoaded">Defaults loaded. Click Save to persist them.</sys:String>
    <sys:String x:Key="StatusCaptureHotkeyReceived">Capture hotkey received. The capture overlay will be added in the next stage.</sys:String>
    <sys:String x:Key="StatusCaptureRegionSelected">Capture region selected: {0} × {1}</sys:String>
    <sys:String x:Key="StatusCaptureRegionCancelled">Capture cancelled.</sys:String>
    <sys:String x:Key="ErrorFrameRate">Frame rate must be between 1 and 30.</sys:String>
    <sys:String x:Key="ErrorDuration">Duration must be between 1 and 60 seconds.</sys:String>
    <sys:String x:Key="ErrorScale">Output scale must be between 25 and 100 percent.</sys:String>
    <sys:String x:Key="ErrorMaxColors">Select a maximum color count.</sys:String>
    <sys:String x:Key="ErrorCouldNotSave">Could not save settings: {0}</sys:String>
    <sys:String x:Key="HotkeyErrorEmpty">Enter a hotkey such as Ctrl+Shift+G.</sys:String>
    <sys:String x:Key="HotkeyErrorMissingModifier">A hotkey must contain at least one modifier and one key.</sys:String>
    <sys:String x:Key="HotkeyErrorDuplicateModifier">The modifier is repeated.</sys:String>
    <sys:String x:Key="HotkeyErrorMultipleKeys">Enter only one non-modifier key.</sys:String>
    <sys:String x:Key="HotkeyErrorMissingKey">Enter a key after the modifier(s).</sys:String>
    <sys:String x:Key="HotkeyErrorUnsupportedKey">Use A-Z, 0-9, or F1-F12.</sys:String>
    <sys:String x:Key="TrayOpen">Open</sys:String>
    <sys:String x:Key="TrayExit">Exit</sys:String>
    <sys:String x:Key="TrayStartupUnavailable">Startup setting unavailable</sys:String>
    <sys:String x:Key="TrayGlobalHotkeyUnavailable">Global hotkey unavailable</sys:String>
    <sys:String x:Key="TrayCaptureHotkeyTitle">Capture hotkey received</sys:String>
    <sys:String x:Key="TrayCaptureHotkeyMessage">The capture overlay will be added in the next stage.</sys:String>
    <sys:String x:Key="CaptureOverlayTitle">Select capture region</sys:String>
    <sys:String x:Key="CaptureOverlayHint">Drag to select a region. Press Enter to confirm or Esc to cancel.</sys:String>
    <sys:String x:Key="TrayCaptureRegionSelected">Capture region selected</sys:String>
    <sys:String x:Key="TrayCaptureRegionCancelled">Capture cancelled</sys:String>
    <sys:String x:Key="TrayCaptureRegionCancelledMessage">No capture was recorded.</sys:String>
    <sys:String x:Key="TrayCaptureRegionSize">{0} × {1}</sys:String>
</ResourceDictionary>
