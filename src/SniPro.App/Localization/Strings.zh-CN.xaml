    <sys:String x:Key="BrowseButton">浏览...</sys:String>
    <sys:String x:Key="FrameRateLabel">帧率（FPS）</sys:String>
    <sys:String x:Key="DurationLabel">时长（秒）</sys:String>
    <sys:String x:Key="ScaleLabel">输出缩放（%）</sys:String>
    <sys:String x:Key="MaxColorsLabel">最大颜色数</sys:String>
    <sys:String x:Key="EnableDithering">启用抖动</sys:String>
    <sys:String x:Key="StartupLabel">启动</sys:String>
    <sys:String x:Key="StartWithWindows">开机启动</sys:String>
    <sys:String x:Key="CaptureHotkeyLabel">截屏快捷键</sys:String>
    <sys:String x:Key="LanguageLabel">语言</sys:String>
