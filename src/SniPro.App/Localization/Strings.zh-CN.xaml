    <sys:String x:Key="PreviewStartFrame">开始帧</sys:String>
    <sys:String x:Key="PreviewEndFrame">结束帧</sys:String>
    <sys:String x:Key="PreviewCurrentFrame">当前帧</sys:String>
    <sys:String x:Key="PreviewFrameStatus">第 {0}/{1} 帧 · 选中范围 {2}-{3}</sys:String>
