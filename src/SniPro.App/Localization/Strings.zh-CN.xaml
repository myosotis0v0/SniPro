    <sys:String x:Key="TrayCaptureRegionCancelled">截屏已取消</sys:String>
    <sys:String x:Key="TrayCaptureRegionCancelledMessage">未生成截屏。</sys:String>
    <sys:String x:Key="TrayCaptureRegionSize">{0} × {1}</sys:String>
