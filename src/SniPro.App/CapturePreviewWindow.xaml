<Window x:Class="SniPro.App.CapturePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/SniProIcon.ico"
        Title="{DynamicResource PreviewWindowTitle}"
        Width="980" Height="760" MinWidth="680" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="CapturePreviewWindow_Loaded"
        Closing="CapturePreviewWindow_Closing"
        Closed="CapturePreviewWindow_Closed">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="PreviewHeader" Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="23" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" Text="{DynamicResource PreviewWindowTitle}" />
                <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,0" Text="{DynamicResource PreviewSubtitle}" />
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource AccentWashBrush}" CornerRadius="9" Padding="12,6" VerticalAlignment="Center">
                <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Text="GIF" />
            </Border>
        </Grid>

        <Border x:Name="PreviewStage" Grid.Row="1" Background="#1A1620" BorderBrush="#DDD5E7" BorderThickness="1" CornerRadius="16" Padding="10" ClipToBounds="True">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Background="#D9272230" CornerRadius="8" Padding="10,6">
                    <TextBlock x:Name="FrameStatusText" Foreground="White" FontSize="11" />
                </Border>
            </Grid>
        </Border>

        <Border x:Name="TimelinePanel" Grid.Row="2" Margin="0,14,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="15" Padding="20,15">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" Text="{DynamicResource PreviewTrimTitle}" />
                <Border x:Name="TimelineStrip" Grid.Row="1" Height="48" Margin="0,0,0,9" Background="#211C2B" CornerRadius="8" ClipToBounds="True" Cursor="SizeWE" ToolTip="{DynamicResource PreviewTimelineHint}" AutomationProperties.Name="{DynamicResource PreviewTimelineHint}" MouseLeftButtonDown="TimelineStrip_MouseLeftButtonDown" MouseMove="TimelineStrip_MouseMove" MouseLeftButtonUp="TimelineStrip_MouseLeftButtonUp" LostMouseCapture="TimelineStrip_LostMouseCapture">
                    <Grid>
                        <ItemsControl x:Name="TimelineThumbnails" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="1,0" ClipToBounds="True">
                                        <Image Source="{Binding}" Stretch="UniformToFill" Height="48" RenderOptions.BitmapScalingMode="LowQuality" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Canvas x:Name="TimelineOverlay" IsHitTestVisible="False" SizeChanged="TimelineOverlay_SizeChanged">
                            <Border x:Name="TimelineLeftShade" Height="48" Background="#880E0A18" />
                            <Border x:Name="TimelineRightShade" Height="48" Background="#880E0A18" />
                            <Border x:Name="TimelineRange" Height="48" BorderBrush="#D4BFFF" BorderThickness="2" CornerRadius="7" />
                            <Border x:Name="TimelineStartHandle" Width="9" Height="28" Background="#D4BFFF" CornerRadius="3" Canvas.Top="10" />
                            <Border x:Name="TimelineEndHandle" Width="9" Height="28" Background="#D4BFFF" CornerRadius="3" Canvas.Top="10" />
                            <Border x:Name="TimelinePlayhead" Height="48" Width="3" Background="#FF8267" />
                            <Path x:Name="TimelinePlayheadMarker" Width="12" Height="8" Data="M 0 0 L 12 0 L 6 8 Z" Fill="#FF8267" />
                        </Canvas>
                    </Grid>
                </Border>
                <Grid Grid.Row="2" Margin="0,0,0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource PreviewStartFrame}" />
                    <Slider x:Name="StartFrameSlider" Grid.Column="1" Style="{StaticResource SoftSliderStyle}" Minimum="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StartFrameSlider_ValueChanged" />
                </Grid>
                <Grid Grid.Row="3" Margin="0,0,0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource PreviewEndFrame}" />
                    <Slider x:Name="EndFrameSlider" Grid.Column="1" Style="{StaticResource SoftSliderStyle}" Minimum="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="EndFrameSlider_ValueChanged" />
                </Grid>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource PreviewCurrentFrame}" />
                    <Slider x:Name="CurrentFrameSlider" Grid.Column="1" Style="{StaticResource SoftSliderStyle}" Minimum="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="CurrentFrameSlider_ValueChanged" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock x:Name="SaveStatusText" Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource PreviewSaveHint}" TextWrapping="Wrap" />
                <ProgressBar x:Name="SaveProgressBar" Height="3" Margin="0,8,0,0" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PlayButton" Style="{StaticResource SoftButtonStyle}" Content="{DynamicResource PreviewPause}" Click="PlayButton_Click" />
                <Button x:Name="CloseButton" Style="{StaticResource SoftButtonStyle}" Margin="8,0,0,0" Content="{DynamicResource PreviewClose}" Click="CloseButton_Click" />
                <Button x:Name="SaveGifButton" Style="{StaticResource AccentButtonStyle}" Margin="8,0,0,0" MinWidth="115" Content="{DynamicResource PreviewSave}" Click="SaveGifButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
