<Window x:Class="SniPro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/SniProIcon.ico"
        Title="{DynamicResource SettingsWindowTitle}"
        Height="560"
        Width="560"
        MinHeight="560"
        MinWidth="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Text="{DynamicResource AppSettingsTitle}" />
            <TextBlock x:Name="VersionText"
                       Margin="12,10,0,0"
                       VerticalAlignment="Center"
                       Foreground="Gray" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="{DynamicResource OutputDirectoryLabel}" />
            <TextBox x:Name="OutputDirectoryTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,12" />
            <Button x:Name="BrowseButton" Grid.Row="0" Grid.Column="2" Margin="0,0,0,12" Padding="12,4" Content="{DynamicResource BrowseButton}" Click="BrowseButton_Click" />

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="{DynamicResource FrameRateLabel}" />
            <TextBox x:Name="FrameRateTextBox" Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,0,0,12" />

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="{DynamicResource ScaleLabel}" />
            <TextBox x:Name="ScalePercentTextBox" Grid.Row="2" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,0,0,12" />

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="{DynamicResource MaxColorsLabel}" />
            <ComboBox x:Name="MaxColorsComboBox" Grid.Row="3" Grid.Column="1" Width="110" HorizontalAlignment="Left" Margin="0,0,0,12" />

            <CheckBox x:Name="EnableDitheringCheckBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,4" Content="{DynamicResource EnableDithering}" />

            <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="{DynamicResource StartupLabel}" />
            <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,12" VerticalAlignment="Center" Content="{DynamicResource StartWithWindows}" />

            <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="{DynamicResource CaptureHotkeyLabel}" />
            <TextBox x:Name="CaptureHotkeyTextBox" Grid.Row="6" Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,0,0,12" />

            <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="{DynamicResource LanguageLabel}" />
            <ComboBox x:Name="LanguageComboBox" Grid.Row="7" Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,0,0,12" SelectedValuePath="Tag">
                <ComboBoxItem Tag="system" Content="{DynamicResource LanguageSystem}" />
                <ComboBoxItem Tag="en-US" Content="{DynamicResource LanguageEnglish}" />
                <ComboBoxItem Tag="zh-CN" Content="{DynamicResource LanguageSimplifiedChinese}" />
            </ComboBox>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ResetButton" Margin="8,0,0,0" Padding="16,6" Content="{DynamicResource ResetButton}" Click="ResetButton_Click" />
            <Button x:Name="SaveButton" Margin="8,0,0,0" Padding="16,6" Content="{DynamicResource SaveButton}" Click="SaveButton_Click" />
            <Button x:Name="CloseButton" Margin="8,0,0,0" Padding="16,6" Content="{DynamicResource CloseButton}" Click="CloseButton_Click" />
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="5"
                   Margin="0,12,0,0"
                   Foreground="Gray"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
