<Window x:Class="SniPro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/SniProIcon.ico"
        Title="{DynamicResource SettingsWindowTitle}"
        Width="690" Height="735" MinWidth="620" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        IsVisibleChanged="MainWindow_IsVisibleChanged">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="SettingsHeader" Grid.Row="0" Background="{StaticResource AccentWashBrush}" CornerRadius="16" Padding="18" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="48" Height="48" Background="White" CornerRadius="14" Margin="0,0,14,0">
                    <Image Source="Assets/SniProIcon.png" Width="36" Height="36" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" Text="{DynamicResource AppSettingsTitle}" />
                    <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="{DynamicResource SettingsSubtitle}" />
                </StackPanel>
                <Border Grid.Column="2" Background="White" CornerRadius="9" Padding="10,5" VerticalAlignment="Top">
                    <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SettingsContent" Margin="0,0,6,0">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="15" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource OutputSectionTitle}" />
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,5,0,14" Text="{DynamicResource OutputSectionDescription}" TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputDirectoryTextBox" Grid.Column="0" Style="{StaticResource SoftTextBoxStyle}" Margin="0,0,8,0" ToolTip="{DynamicResource OutputDirectoryLabel}" />
                            <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource SoftButtonStyle}" Content="{DynamicResource BrowseButton}" Click="BrowseButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="15" Padding="20">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource CaptureSectionTitle}" />
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,5,0,14" Text="{DynamicResource CaptureSectionDescription}" TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,7" Text="{DynamicResource FrameRateLabel}" />
                                    <TextBox x:Name="FrameRateTextBox" Style="{StaticResource SoftTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,7" Text="{DynamicResource ScaleLabel}" />
                                    <TextBox x:Name="ScalePercentTextBox" Style="{StaticResource SoftTextBoxStyle}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,7" Text="{DynamicResource MaxColorsLabel}" />
                                <ComboBox x:Name="MaxColorsComboBox" Style="{StaticResource SoftComboBoxStyle}" ItemContainerStyle="{StaticResource SoftComboBoxItemStyle}" />
                            </StackPanel>
                            <Border Margin="0,14,0,0" Padding="11,10" Background="{StaticResource CanvasBrush}" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{DynamicResource EnableDithering}" />
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,3,0,0" Text="{DynamicResource DitheringDescription}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="EnableDitheringCheckBox" Grid.Column="1" Style="{StaticResource SoftCheckBoxStyle}" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource EnableDithering}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="15" Padding="20">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource BehaviorSectionTitle}" />
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,5,0,14" Text="{DynamicResource BehaviorSectionDescription}" TextWrapping="Wrap" />
                            <CheckBox x:Name="StartWithWindowsCheckBox" Style="{StaticResource SoftCheckBoxStyle}" Content="{DynamicResource StartWithWindows}" Margin="0,0,0,16" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,7" Text="{DynamicResource CaptureHotkeyLabel}" />
                                <TextBox x:Name="CaptureHotkeyTextBox" Style="{StaticResource SoftTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,7" Text="{DynamicResource LanguageLabel}" />
                                <ComboBox x:Name="LanguageComboBox" Style="{StaticResource SoftComboBoxStyle}" ItemContainerStyle="{StaticResource SoftComboBoxItemStyle}" SelectedValuePath="Tag">
                                    <ComboBoxItem Tag="system" Content="{DynamicResource LanguageSystem}" />
                                    <ComboBoxItem Tag="en-US" Content="{DynamicResource LanguageEnglish}" />
                                    <ComboBoxItem Tag="zh-CN" Content="{DynamicResource LanguageSimplifiedChinese}" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ResetButton" Style="{StaticResource SoftButtonStyle}" Content="{DynamicResource ResetButton}" Click="ResetButton_Click" />
                    <Button x:Name="CloseButton" Style="{StaticResource SoftButtonStyle}" Margin="8,0,0,0" Content="{DynamicResource CloseButton}" Click="CloseButton_Click" />
                    <Button x:Name="SaveButton" Style="{StaticResource AccentButtonStyle}" Margin="8,0,0,0" MinWidth="90" Content="{DynamicResource SaveButton}" Click="SaveButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
